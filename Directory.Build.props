<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>

    <Product>RECompose</Product>
    <Authors>nathtjan</Authors>
    <Copyright>Copyright (C) 2026 nathtjan</Copyright>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <Version>0.1.0</Version>

    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <!-- Where the engine build script installs recompose-engine (cmake install, component "engine"). -->
    <RecEngineNativeDir>$(RepoRoot)artifacts/native/bin/</RecEngineNativeDir>
  </PropertyGroup>
</Project>
