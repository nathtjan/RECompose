<!-- SPDX-License-Identifier: AGPL-3.0-or-later -->
<!-- Prepare (UI-10): top bar with the service picker, sidebar with the service and the library, song header with
     transport, key, tempo, readouts and the NOW and NEXT blocks, timeline with the sections lane, editor tabs ENTRY,
     SECTIONS, MIXER and SONG. Perform arrives in milestone 5. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RECompose.Presentation.ViewModels"
        xmlns:c="using:RECompose.App.Controls"
        xmlns:log="using:RECompose.Core.Logging"
        xmlns:local="using:RECompose.App"
        x:Class="RECompose.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="RECompose"
        Width="1440" Height="900"
        MinWidth="1280" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True" WindowDecorations="BorderOnly" ExtendClientAreaTitleBarHeightHint="48">

  <Window.Styles>
    <Style Selector="Ellipse.led">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="Fill" Value="{DynamicResource state-error}" />
    </Style>
    <Style Selector="Ellipse.led.ok">
      <Setter Property="Fill" Value="{DynamicResource state-playing}" />
    </Style>
    <Style Selector="ListBox#Library ListBoxItem">
      <Setter Property="Padding" Value="16,8" />
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="{DynamicResource radius-s-corner}" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="MinWidth" Value="30" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource text-on-section}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="{DynamicResource type-meta-size}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.chip">
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource border}" />
      <Setter Property="CornerRadius" Value="{DynamicResource radius-s-corner}" />
      <Setter Property="Background" Value="{DynamicResource bg-inset}" />
      <Setter Property="Foreground" Value="{DynamicResource text-secondary}" />
      <Setter Property="FontSize" Value="{DynamicResource type-meta-size}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource bg-inset}" />
      <Setter Property="BorderBrush" Value="{DynamicResource control-border}" />
      <Setter Property="Foreground" Value="{DynamicResource text-primary}" />
    </Style>
    <Style Selector="Border.tag">
      <Setter Property="CornerRadius" Value="{DynamicResource radius-s-corner}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource border}" />
      <Setter Property="Background" Value="{DynamicResource bg-inset}" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.tag TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource type-meta-size}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource text-secondary}" />
    </Style>
    <Style Selector="Border.tag.warning">
      <Setter Property="BorderBrush" Value="{DynamicResource state-warning}" />
    </Style>
    <Style Selector="ListBox#ServiceRows ListBoxItem">
      <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style Selector="TextBlock.warning">
      <Setter Property="Foreground" Value="{DynamicResource state-warning}" />
    </Style>
    <Style Selector="ListBox#SectionRows ListBoxItem">
      <Setter Property="Padding" Value="8,2" />
    </Style>
    <Style Selector="Grid.row.flash">
      <Setter Property="Background" Value="{DynamicResource accent-subtle}" />
    </Style>
    <Style Selector="TextBox.cell">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox.cell">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="6,2" />
    </Style>
    <Style Selector="Button.cell">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="8,0" />
    </Style>
    <!-- The drawer leaves the top bar, and the window keys in it, uncovered (Prepare 48, Perform 60) -->
    <Style Selector="Border.drawer">
      <Setter Property="Margin" Value="0,48,0,0" />
    </Style>
    <Style Selector="Border.drawer.perform">
      <Setter Property="Margin" Value="0,60,0,0" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="48,Auto,*">

    <!-- Top bar (UI-11) -->
    <Border Grid.Row="0" Classes="topbar" Padding="16,0,0,0" IsVisible="{Binding IsPrepare}">
      <DockPanel>
        <c:CaptionButtons DockPanel.Dock="Right" Margin="12,0,0,0" />
        <Panel DockPanel.Dock="Left" Classes="traffic-lights" />
        <Button x:Name="AppMenuButton" DockPanel.Dock="Left" Classes="ghost" Content="Menu" IsVisible="False" VerticalAlignment="Center" Margin="0,0,12,0"
                AutomationProperties.Name="Menu" />
        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="18" Margin="0,0,24,0">
          <Run Text="REC" FontWeight="ExtraBold" /><Run Text="ompose" FontWeight="Medium" />
        </TextBlock>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
          <ToggleButton Content="Prepare" IsChecked="{Binding IsPrepare, Mode=OneWay}" IsHitTestVisible="False" />
          <ToggleButton x:Name="PerformToggle" Content="Perform" IsChecked="{Binding IsPerform, Mode=TwoWay}" ToolTip.Tip="Perform (Ctrl+P). Playback keeps going." AutomationProperties.Name="Perform" />
        </StackPanel>
        <ComboBox x:Name="ServicePicker" DockPanel.Dock="Left" Margin="24,0,0,0" VerticalAlignment="Center" MinWidth="240"
                  ItemsSource="{Binding Setlist.Services}" SelectedItem="{Binding Setlist.CurrentChoice}" PlaceholderText="No service"
                  IsVisible="{Binding Setlist.HasService}" AutomationProperties.Name="Service" ToolTip.Tip="The service to prepare">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ServiceChoice">
              <TextBlock Text="{Binding Title}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <Button DockPanel.Dock="Right" Command="{Binding ToggleAssistantCommand}" ToolTip.Tip="Assistant (Ctrl+J)" Margin="12,0,0,0" VerticalAlignment="Center"
                AutomationProperties.Name="Assistant">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:Icon Glyph="assistant" IconSize="16" VerticalAlignment="Center" />
            <TextBlock Text="Assistant" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button DockPanel.Dock="Right" Command="{Binding OpenControlsCommand}" ToolTip.Tip="Keys, pedals and jump timing" Margin="12,0,0,0" VerticalAlignment="Center"
                AutomationProperties.Name="Controls">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:Icon Glyph="pedal" IconSize="16" VerticalAlignment="Center" />
            <TextBlock Text="Controls" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button DockPanel.Dock="Right" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Settings (Ctrl+,)" Margin="12,0,0,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:Icon Glyph="settings" IconSize="16" VerticalAlignment="Center" />
            <TextBlock Text="Settings" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button DockPanel.Dock="Right" Classes="ghost" Command="{Binding OpenSettingsCommand}" VerticalAlignment="Center"
                ToolTip.Tip="Audio device. Click to change it.">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Classes="led" Classes.ok="{Binding AudioOk}" VerticalAlignment="Center" />
            <TextBlock Classes="label" Text="AUDIO" VerticalAlignment="Center" />
            <TextBlock Classes="mono" Text="{Binding AudioStatus}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button DockPanel.Dock="Right" Classes="ghost" Command="{Binding OpenCheckCommand}" VerticalAlignment="Center" IsVisible="{Binding HasMidiStatus}"
                ToolTip.Tip="MIDI controllers. Click for the service check." AutomationProperties.Name="MIDI">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Classes="led" Classes.ok="{Binding MidiOk}" VerticalAlignment="Center" />
            <TextBlock Classes="label" Text="MIDI" VerticalAlignment="Center" />
            <TextBlock Classes="mono" Text="{Binding MidiStatus}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button DockPanel.Dock="Right" Classes="ghost" Command="{Binding VoiceIndicatorCommand}" VerticalAlignment="Center" Margin="0,0,16,0"
                IsVisible="{Binding VoiceOn}" ToolTip.Tip="{Binding VoiceToolTip}" AutomationProperties.Name="Voice">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Classes="led" Classes.ok="{Binding VoiceOk}" VerticalAlignment="Center" />
            <TextBlock Classes="label" Text="VOICE" VerticalAlignment="Center" />
            <TextBlock Classes="mono" Text="{Binding VoiceIndicator}" VerticalAlignment="Center" />
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding VoiceLevel}" Width="40" Height="4" MinHeight="4" MinWidth="40" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <TextBlock DockPanel.Dock="Right" Classes="meta" Text="{Binding UpdateStatus}" IsVisible="{Binding HasUpdate}" VerticalAlignment="Center" Margin="0,0,16,0" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,16,0"
                    IsVisible="{Binding HasBackgroundActivity}" ToolTip.Tip="{Binding BackgroundActivity}">
          <c:Icon Glyph="rendering" IconSize="14" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource state-pending}" />
          <TextBlock Classes="meta" Text="{Binding BackgroundActivity}" VerticalAlignment="Center" MaxWidth="360" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Panel />
      </DockPanel>
    </Border>

    <!-- Banner (UI-70): stays until dismissed or resolved -->
    <Border Grid.Row="1" Classes="banner" Classes.error="{Binding AudioLost}">
      <Border.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="HasBanner" />
          <Binding Path="IsPrepare" />
        </MultiBinding>
      </Border.IsVisible>
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="ghost" Content="Dismiss" Command="{Binding DismissBannerCommand}" />
        <Button DockPanel.Dock="Right" Classes="primary" Content="Switch back" Command="{Binding SwitchBackCommand}" IsVisible="{Binding CanSwitchBack}" Margin="0,0,8,0" />
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <c:Icon Glyph="warning" IconSize="16" TextElement.Foreground="{DynamicResource state-warning}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Banner}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="300,*" IsVisible="{Binding IsPrepare}">

      <!-- Sidebar (UI-12): the service (SL-1…7) over the library (SL-56) -->
      <Border Grid.Column="0" Classes="panel" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="3*,4,2*,Auto">
        <DockPanel Grid.Row="0" x:Name="ServiceBlock" DataContext="{Binding Setlist}" x:DataType="vm:SetlistViewModel"
                   Background="Transparent" DragDrop.AllowDrop="True">
          <StackPanel DockPanel.Dock="Top" Margin="16,16,16,8" Spacing="4">
            <DockPanel>
              <Button x:Name="ServiceMenuButton" DockPanel.Dock="Right" Classes="ghost cell" ToolTip.Tip="New, duplicate, rename or delete the service"
                      AutomationProperties.Name="Service menu" Padding="4,0" MinHeight="24" Height="24">
                <c:Icon Glyph="more" IconSize="16" />
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuItem Header="New service…" Command="{Binding NewServiceCommand}" />
                    <MenuItem Header="Duplicate service…" Command="{Binding DuplicateServiceCommand}" />
                    <MenuItem Header="Rename…" Command="{Binding RenameServiceCommand}" />
                    <MenuItem Header="{Binding AutoAdvanceLabel}" Command="{Binding AutoAdvanceCommand}" />
                    <Separator />
                    <MenuItem Header="Restore earlier version…" Command="{Binding RestoreVersionCommand}" />
                    <MenuItem Header="Export service…" Command="{Binding ExportServiceCommand}" />
                    <MenuItem Header="Export report" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ExportReportCommand}" />
                    <MenuItem Header="Import service…" Command="{Binding ImportServiceCommand}" />
                    <Separator />
                    <MenuItem Header="Delete" Command="{Binding DeleteServiceCommand}" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
              <TextBlock Classes="label" Text="SERVICE" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Classes="heading" Text="{Binding Title}" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasService}" />
            <TextBlock Classes="mono" x:Name="ServiceSummary" Foreground="{DynamicResource text-secondary}" Text="{Binding Summary}" IsVisible="{Binding HasService}" />
          </StackPanel>

          <!-- UI-80: no service, and an empty one -->
          <StackPanel DockPanel.Dock="Top" Margin="16,4,16,8" Spacing="8" IsVisible="{Binding HasNoService}">
            <TextBlock Text="Create a service for this Sunday" TextWrapping="Wrap" />
            <Button Classes="primary" Content="New service" Command="{Binding NewServiceCommand}" HorizontalAlignment="Left" />
          </StackPanel>
          <Border DockPanel.Dock="Top" Classes="inset" Margin="16,4,16,8" Padding="12,10" IsVisible="{Binding IsEmpty}">
            <TextBlock Classes="meta" TextWrapping="Wrap" Text="Add songs from the library (drag them here)" />
          </Border>

          <ListBox x:Name="ServiceRows" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" Background="Transparent"
                   DragDrop.AllowDrop="True" AutomationProperties.Name="Service entries">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SetlistRowViewModel">
                <!-- The loaded entry has an accent bar down its left edge, so it never sits as a second green dot beside Playing
                     (the margin undoes the item padding so it runs the full height) -->
                <Border Classes.loaded="{Binding IsLoaded}" BorderThickness="3,0,0,0" Margin="-12,-6,0,-6" Padding="9,6,0,6">
                <StackPanel Spacing="6" AutomationProperties.Name="{Binding AccessibleName}">
                  <Grid ColumnDefinitions="22,*,Auto">
                    <TextBlock Grid.Column="0" Classes="mono" Text="{Binding Index}" Foreground="{DynamicResource text-secondary}" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="meta" Text="{Binding VariantText}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="meta" Text="·" IsVisible="{Binding LengthText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock Classes="meta" Text="{Binding LengthText}" />
                      </StackPanel>
                      <TextBlock Classes="meta warning" Text="{Binding Problem}" IsVisible="{Binding HasProblem}" TextWrapping="Wrap" />
                      <TextBlock Classes="meta" Text="{Binding Notes}" IsVisible="{Binding Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top" Margin="8,2,0,0">
                      <c:Icon Glyph="warning" IconSize="14" IsVisible="{Binding HasProblem}" TextElement.Foreground="{DynamicResource state-warning}" ToolTip.Tip="{Binding Problem}" />
                      <c:Icon Glyph="play" IconSize="12" IsVisible="{Binding IsPlaying}" TextElement.Foreground="{DynamicResource state-playing}" ToolTip.Tip="Playing" />
                      <TextBlock Classes="mono" Text="{Binding KeyText}" />
                    </StackPanel>
                  </Grid>
                  <!-- The transition into the next song (SL-20): click for the popover (SL-21) -->
                  <Button Classes="chip" Tag="{Binding Id}" Click="OnTransitionChipClick" IsVisible="{Binding HasChip}" Margin="22,0,0,0"
                          ToolTip.Tip="Transition into the next song" AutomationProperties.Name="{Binding ChipText}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <c:Icon Glyph="transition" IconSize="12" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding ChipText}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <GridSplitter Grid.Row="1" Height="4" Background="{DynamicResource border}" ResizeDirection="Rows" />

        <DockPanel Grid.Row="2">
          <StackPanel DockPanel.Dock="Top" Margin="16,16,16,8" Spacing="8">
            <DockPanel>
              <Button DockPanel.Dock="Right" Command="{Binding ImportCommand}" ToolTip.Tip="Import a stems folder (Ctrl+I)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:Icon Glyph="folder" IconSize="16" VerticalAlignment="Center" />
                  <TextBlock Text="Import" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <TextBlock Classes="label" Text="LIBRARY" VerticalAlignment="Center" />
            </DockPanel>
            <!-- Songs | Pads (UI-12, SL-47) -->
            <StackPanel Orientation="Horizontal" Spacing="2">
              <ToggleButton Content="Songs" IsChecked="{Binding SongsKey}" />
              <ToggleButton Content="Pads" IsChecked="{Binding PadsKey}" />
            </StackPanel>
            <TextBox x:Name="Search" PlaceholderText="Search title or key" Text="{Binding SearchText}" IsVisible="{Binding ShowSongs}" />
          </StackPanel>

          <StackPanel DockPanel.Dock="Top" Margin="16" Spacing="4" IsVisible="{Binding ShowPads}">
            <TextBlock Classes="meta" TextWrapping="Wrap" IsVisible="{Binding PadsEmpty}"
                       Text="No pad sets yet. Import a folder of twelve pad files named by key (C, D♭ … B)." />
            <ItemsControl x:Name="PadSetList" ItemsSource="{Binding PadSets}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PadSetItem">
                  <StackPanel Spacing="2" Margin="0,4">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="meta" Text="{Binding MetaLine}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <TextBlock DockPanel.Dock="Top" Margin="16" TextWrapping="Wrap" Classes="meta" IsVisible="{Binding LibraryEmpty}"
                     Text="No songs yet. Drag a folder of stems onto this window, or press Import." />

          <ListBox x:Name="Library" ItemsSource="{Binding Songs}" SelectedItem="{Binding SelectedSong}" Background="Transparent" IsVisible="{Binding ShowSongs}"
                   ToolTip.Tip="Double-click to load; drag onto the service to add it">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SongItemViewModel">
                <!-- The loaded song has the accent bar, as in the service (the margin undoes the item padding so it runs the full height) -->
                <Border Classes.loaded="{Binding IsLoaded}" BorderThickness="3,0,0,0" Margin="-16,-8,0,-8" Padding="13,8,0,8">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="meta" Text="{Binding MetaLine}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="meta" Text="{Binding Activity}" IsVisible="{Binding HasActivity}" Foreground="{DynamicResource state-pending}"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <!-- Pads (UI-12, SL-40…46): twelve keys in two rows, play/stop, Follow song, volume, fade -->
        <Border Grid.Row="3" Classes="panel" BorderThickness="0,1,0,0" Padding="12,8" DataContext="{Binding Pads}" x:DataType="vm:PadsViewModel" IsVisible="{Binding HasSet}">
          <StackPanel Spacing="6">
            <DockPanel>
              <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Sets}" SelectedItem="{Binding CurrentSet}" MinWidth="120" AutomationProperties.Name="Pad set">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:PadSetItem"><TextBlock Text="{Binding Name}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Classes="label" Text="PADS" VerticalAlignment="Center" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding FirstRow}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PadKeyViewModel">
                    <ToggleButton Classes="ms" Tag="{Binding PitchClass}" Click="OnPadKeyClick" IsChecked="{Binding IsPlaying, Mode=OneWay}" Content="{Binding Label}"
                                  Width="38" Padding="0" AutomationProperties.Name="{Binding AccessibleName}"
                                  ToolTip.Tip="{Binding AccessibleName}" />
                  </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding SecondRow}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PadKeyViewModel">
                    <ToggleButton Classes="ms" Tag="{Binding PitchClass}" Click="OnPadKeyClick" IsChecked="{Binding IsPlaying, Mode=OneWay}" Content="{Binding Label}"
                                  Width="38" Padding="0" AutomationProperties.Name="{Binding AccessibleName}"
                                  ToolTip.Tip="{Binding AccessibleName}" />
                  </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel>
              <Button DockPanel.Dock="Left" Content="{Binding PlayStopLabel}" Command="{Binding PlayStopCommand}" Margin="0,0,8,0" Width="64" />
              <CheckBox DockPanel.Dock="Left" Content="Follow song" IsChecked="{Binding Follow}" Margin="0,0,8,0" ToolTip.Tip="The pad follows the song's key, key lifts included" />
              <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding FadeChoices}" SelectedItem="{Binding Fade}" AutomationProperties.Name="Pad fade time" ToolTip.Tip="Fade time" />
              <Slider Minimum="-40" Maximum="0" Value="{Binding VolumeDb}" Margin="0,0,8,0" AutomationProperties.Name="Pad volume" ToolTip.Tip="Pad volume" />
            </DockPanel>
          </StackPanel>
        </Border>
        </Grid>
      </Border>

      <!-- Song area -->
      <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto,300">

        <!-- Empty state (UI-80) -->
        <StackPanel Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding !HasSong}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
          <TextBlock Classes="title" Text="Import a song to begin" HorizontalAlignment="Center" IsVisible="{Binding LibraryEmpty}" />
          <TextBlock Classes="title" Text="Load a song" HorizontalAlignment="Center" IsVisible="{Binding !LibraryEmpty}" />
          <TextBlock Classes="meta" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460"
                     Text="Drag a folder of stems onto this window, or press Ctrl+I. Double-click a song in the service or the library to load it." />
          <Button HorizontalAlignment="Center" Command="{Binding ImportCommand}" Content="Import a stems folder" />
        </StackPanel>

        <!-- Song header (UI-13): title, key BPM meter, transport, readouts -->
        <Border Grid.Row="0" Classes="panel" BorderThickness="0,0,0,1" Padding="16,12" IsVisible="{Binding HasSong}">
          <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
              <TextBlock Classes="title" Text="{Binding Song.Title}" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="HeaderLine" Classes="meta" Text="{Binding Song.HeaderLine}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Song.HeaderLine}" />
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                <TextBlock Classes="label" Text="PLAYING" VerticalAlignment="Center" />
                <ComboBox x:Name="VariantSelect" ItemsSource="{Binding Entry.Variants}" SelectedItem="{Binding Entry.SelectedVariant}"
                          MinWidth="160" MaxWidth="260" AutomationProperties.Name="Variant"
                          ToolTip.Tip="The arrangement that plays: the song as written, or one of its variants">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:VariantChoice">
                      <TextBlock Text="{Binding Display}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0">
              <Button Command="{Binding ToStartCommand}" ToolTip.Tip="To the start" AutomationProperties.Name="To the start" Width="44">
                <c:Icon Glyph="restart" IconSize="16" HorizontalAlignment="Center" />
              </Button>
              <Button Command="{Binding StopCommand}" ToolTip.Tip="Stop" AutomationProperties.Name="Stop" Width="44">
                <c:Icon Glyph="stop" IconSize="16" HorizontalAlignment="Center" />
              </Button>
              <Button Command="{Binding NextSongCommand}" ToolTip.Tip="Next song" AutomationProperties.Name="Next song" Width="44">
                <c:Icon Glyph="next" IconSize="16" HorizontalAlignment="Center" />
              </Button>
              <Button Classes="primary" Command="{Binding PlayPauseCommand}" ToolTip.Tip="Play or pause (Space)" Width="96">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:Icon Glyph="play" IconSize="16" IsVisible="{Binding !IsPlaying}" VerticalAlignment="Center" />
                  <c:Icon Glyph="pause" IconSize="16" IsVisible="{Binding IsPlaying}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding PlayLabel}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
              <StackPanel Spacing="2">
                <TextBlock Classes="label" Text="SONG BAR" />
                <TextBlock Classes="readout" Text="{Binding SongBarText}" MinWidth="170" />
              </StackPanel>
              <StackPanel Spacing="2">
                <TextBlock Classes="label" Text="TIME" />
                <TextBlock Classes="readout" Text="{Binding TimeText}" MinWidth="150" />
              </StackPanel>
              <StackPanel Spacing="4" VerticalAlignment="Center">
                <Border Classes="pill" Classes.playing="{Binding IsPlaying}" Classes.loading="{Binding IsLoadingStatus}" HorizontalAlignment="Left">
                  <TextBlock Text="{Binding Status}" />
                </Border>
                <TextBlock Classes="mono" Foreground="{DynamicResource text-secondary}" Text="{Binding ChartBarText}" />
              </StackPanel>
            </StackPanel>

            <!-- NOW and NEXT for the song as written (PB-30, PB-31, PB-35, LIVE-20 rule 4) -->
            <Grid Grid.Row="1" Grid.ColumnSpan="3" ColumnDefinitions="*,*,Auto" Margin="0,12,0,0" IsVisible="{Binding HasSections}">
              <Border Grid.Column="0" Classes="inset" Padding="12,8" Margin="0,0,6,0">
                <StackPanel Spacing="4">
                  <TextBlock Classes="label" Text="NOW" />
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock x:Name="NowLabel" Classes="heading" Text="{Binding NowLabel}" />
                    <TextBlock Classes="readout" Text="{Binding NowDetail}" VerticalAlignment="Center" />
                    <TextBlock Classes="meta" Text="{Binding NowPassText}" VerticalAlignment="Center"
                               IsVisible="{Binding NowPassText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                  <TextBlock Classes="meta" Text="{Binding NowNoteText}" TextTrimming="CharacterEllipsis"
                             IsVisible="{Binding NowNoteText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <ProgressBar Minimum="0" Maximum="1" Value="{Binding SectionProgress}" Height="4" MinHeight="4" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="inset" Padding="12,8" Margin="6,0,0,0">
                <StackPanel Spacing="4">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="label" Text="NEXT" />
                    <TextBlock Classes="label" Text="·" />
                    <TextBlock Classes="label" Text="{Binding NextTag}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock x:Name="NextLabel" Classes="heading" Text="{Binding NextLabel}" />
                    <TextBlock Classes="readout" Text="{Binding CountdownText}" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Classes="meta" Text="{Binding NextNoteText}" TextTrimming="CharacterEllipsis"
                             IsVisible="{Binding NextNoteText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
              </Border>
              <!-- KEY and TEMPO of the loaded service entry (UI-13, PB-60), with the live key badge (PB-61) -->
              <Border Grid.Column="2" Classes="inset" Padding="12,8" Margin="12,0,0,0" IsVisible="{Binding HasLoadedEntry}">
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="4" RowSpacing="4">
                  <TextBlock Grid.Row="0" Classes="label" Text="KEY" VerticalAlignment="Center" Margin="0,0,6,0" />
                  <Button Grid.Row="0" Grid.Column="1" Classes="cell" Command="{Binding KeyDownCommand}" ToolTip.Tip="Key down (Ctrl+↓)" AutomationProperties.Name="Key down">
                    <c:Icon Glyph="minus" IconSize="14" />
                  </Button>
                  <TextBlock Grid.Row="0" Grid.Column="2" x:Name="HeaderKey" Classes="mono" Classes.warning="{Binding EntryKeyWarning}" Text="{Binding EntryKeyText}"
                             MinWidth="64" TextAlignment="Center" VerticalAlignment="Center" Background="Transparent" ToolTip.Tip="Double-click to type a key" />
                  <TextBox Grid.Row="0" Grid.Column="2" x:Name="HeaderKeyEdit" Classes="inline" IsVisible="False" AutomationProperties.Name="Key" />
                  <Button Grid.Row="0" Grid.Column="3" Classes="cell" Command="{Binding KeyUpCommand}" ToolTip.Tip="Key up (Ctrl+↑)" AutomationProperties.Name="Key up">
                    <c:Icon Glyph="plus" IconSize="14" />
                  </Button>
                  <TextBlock Grid.Row="1" Classes="label" Text="TEMPO" VerticalAlignment="Center" Margin="0,0,6,0" />
                  <Button Grid.Row="1" Grid.Column="1" Classes="cell" Command="{Binding TempoDownCommand}" ToolTip.Tip="Tempo −1% (Ctrl+←, Shift for 5%)" AutomationProperties.Name="Tempo down">
                    <c:Icon Glyph="minus" IconSize="14" />
                  </Button>
                  <TextBlock Grid.Row="1" Grid.Column="2" x:Name="HeaderTempo" Classes="mono" Text="{Binding EntryTempoText}" MinWidth="64" TextAlignment="Center" VerticalAlignment="Center"
                             Background="Transparent" ToolTip.Tip="Double-click to type a tempo" />
                  <TextBox Grid.Row="1" Grid.Column="2" x:Name="HeaderTempoEdit" Classes="inline" IsVisible="False" AutomationProperties.Name="Tempo" />
                  <Button Grid.Row="1" Grid.Column="3" Classes="cell" Command="{Binding TempoUpCommand}" ToolTip.Tip="Tempo +1% (Ctrl+→, Shift for 5%)" AutomationProperties.Name="Tempo up">
                    <c:Icon Glyph="plus" IconSize="14" />
                  </Button>
                  <Border Grid.Row="2" Grid.ColumnSpan="4" Classes="tag warning" HorizontalAlignment="Left" IsVisible="{Binding HasLiveKeyBadge}"
                          ToolTip.Tip="Key and tempo are processed live; rendered stems for the service come with the service check">
                    <TextBlock Text="{Binding LiveKeyBadge}" />
                  </Border>
                </Grid>
              </Border>
            </Grid>

            <!-- UI-80: no sections yet -->
            <Border Grid.Row="1" Grid.ColumnSpan="3" Classes="inset" Padding="12,10" Margin="0,12,0,0" IsVisible="{Binding !HasSections}">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                  <Button Classes="primary" Content="Detect from guide" Command="{Binding Sections.DetectCommand}"
                          ToolTip.Tip="{Binding Sections.DetectHint}" />
                  <Button Content="Mark at playhead (M)" Command="{Binding MarkCommand}" />
                </StackPanel>
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                  <Run Text="No sections yet." FontWeight="Bold" />
                  <Run Text=" Detect them from the guide, or play the song and press M at each section." />
                </TextBlock>
              </DockPanel>
            </Border>
          </Grid>
        </Border>

        <!-- Timeline (UI-15): lane headers and lanes scroll together -->
        <ScrollViewer Grid.Row="1" IsVisible="{Binding HasSong}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Grid ColumnDefinitions="240,*">
            <StackPanel Grid.Column="0">
              <Border Height="28" Classes="panel" BorderThickness="0,0,1,1" Padding="12,0">
                <DockPanel>
                  <ToggleButton DockPanel.Dock="Right" Classes="ms" Content="Follow" IsChecked="{Binding FollowPlayhead}" Padding="6,0"
                                Height="22" MinHeight="22" ToolTip.Tip="Follow the playhead when zoomed in (.)" />
                  <ToggleButton DockPanel.Dock="Left" Classes="ms" Content="{Binding TimelineModeLabel}" IsChecked="{Binding TimelineAsHeard}"
                                Padding="6,0" Height="22" MinHeight="22" Margin="0,0,8,0"
                                ToolTip.Tip="As heard shows the playing variant in its own order; As written shows the song as it was recorded" />
                  <TextBlock Classes="label" Text="TRACKS" VerticalAlignment="Center" />
                </DockPanel>
              </Border>
              <Border Height="32" Classes="panel" BorderThickness="0,0,1,1" Padding="12,0">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Classes="ghost cell" Command="{Binding MarkCommand}" ToolTip.Tip="Mark a section at the playhead (M)"
                          Padding="4,0" MinHeight="24" Height="24">
                    <c:Icon Glyph="plus" IconSize="14" />
                  </Button>
                  <TextBlock Classes="label" Text="{Binding TimelineLaneLabel}" VerticalAlignment="Center" />
                </DockPanel>
              </Border>
              <ItemsControl ItemsSource="{Binding Song.Tracks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TrackViewModel">
                    <Border Height="56" Classes="panel" BorderThickness="0,0,1,1" Padding="12,0">
                      <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                          <ToggleButton Classes="ms mute" Content="M" IsChecked="{Binding Mute}" ToolTip.Tip="Mute" />
                          <ToggleButton Classes="ms solo" Content="S" IsChecked="{Binding Solo}" ToolTip.Tip="Solo" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="meta" Text="{Binding RoleLabel}" />
                            <TextBlock Classes="meta" Text="{Binding OutputLabel}" />
                            <TextBlock Classes="meta error" Text="{Binding Problem}" IsVisible="{Binding Missing}" />
                          </StackPanel>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <c:TimelineView x:Name="Timeline" Grid.Column="1" VerticalAlignment="Top"
                            Song="{Binding Song}"
                            Position="{Binding TimelinePosition}"
                            AsHeard="{Binding TimelineAsHeard}"
                            SelectedEntry="{Binding Entry.SelectedId, FallbackValue={x:Null}}"
                            Version="{Binding Song.WaveformVersion, FallbackValue=0}"
                            Follow="{Binding FollowPlayhead}"
                            IsPlaying="{Binding IsPlaying}"
                            SectionsVersion="{Binding Song.SectionsVersion, FallbackValue=0}"
                            SelectedSection="{Binding Sections.Selected.Id, FallbackValue={x:Null}}" />
          </Grid>
        </ScrollViewer>

        <GridSplitter Grid.Row="2" Height="4" Background="{DynamicResource border}" ResizeDirection="Rows" IsVisible="{Binding HasSong}" />

        <!-- Editor tabs (UI-16): SECTIONS, MIXER and SONG -->
        <TabControl Grid.Row="3" IsVisible="{Binding HasSong}" SelectedIndex="{Binding SelectedTab}" Padding="0" Background="{DynamicResource bg-surface}">
          <TabItem Header="ENTRY">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <DockPanel Margin="16,12,16,0">
            <Border DockPanel.Dock="Top" Classes="inset" Padding="12,8" Margin="0,0,0,8" DataContext="{Binding Setlist}" x:DataType="vm:SetlistViewModel"
                    IsVisible="{Binding HasSelection}">
              <StackPanel Spacing="8">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <Button Content="Edit for this service only" Command="{Binding MakeCustomCommand}" ToolTip.Tip="Copy the variant into this service; the song's variant stays as it is" />
                    <Button Content="{Binding RevertText}" Command="{Binding RevertCommand}" IsVisible="{Binding CanRevert}" />
                    <Button Content="Save as variant…" Command="{Binding SaveAsVariantCommand}" IsVisible="{Binding IsCustom}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="EditingHeader" Classes="heading" Text="{Binding EditingText}" VerticalAlignment="Center" />
                    <Border Classes="tag" IsVisible="{Binding IsSelectionNotLoaded}">
                      <TextBlock Text="not loaded" />
                    </Border>
                    <Button Classes="primary" Content="Load" Command="{Binding LoadSelectedCommand}" IsVisible="{Binding IsSelectionNotLoaded}" />
                    <TextBlock Classes="meta" Text="{Binding ArrangementText}" VerticalAlignment="Center" />
                  </StackPanel>
                </DockPanel>
                <WrapPanel Orientation="Horizontal">
                  <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,16,4">
                    <TextBlock Classes="label" Text="KEY" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <Button Classes="cell" Command="{Binding KeyDownCommand}" AutomationProperties.Name="Entry key down"><c:Icon Glyph="minus" IconSize="14" /></Button>
                    <Panel>
                      <TextBlock x:Name="EntryKey" Classes="mono" Classes.warning="{Binding KeyWarning}" Text="{Binding KeyText}" MinWidth="60" TextAlignment="Center" VerticalAlignment="Center"
                                 Background="Transparent" ToolTip.Tip="{Binding KeyTip}" />
                      <TextBox x:Name="EntryKeyEdit" Classes="inline" IsVisible="False" AutomationProperties.Name="Entry key" />
                    </Panel>
                    <Button Classes="cell" Command="{Binding KeyUpCommand}" AutomationProperties.Name="Entry key up"><c:Icon Glyph="plus" IconSize="14" /></Button>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,16,4">
                    <TextBlock Classes="label" Text="TEMPO" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <Button Classes="cell" Command="{Binding TempoDownCommand}" AutomationProperties.Name="Entry tempo down"><c:Icon Glyph="minus" IconSize="14" /></Button>
                    <Panel>
                      <TextBlock x:Name="EntryTempo" Classes="mono" Text="{Binding TempoText}" MinWidth="48" TextAlignment="Center" VerticalAlignment="Center"
                                 Background="Transparent" ToolTip.Tip="Double-click to type a tempo" />
                      <TextBox x:Name="EntryTempoEdit" Classes="inline" IsVisible="False" AutomationProperties.Name="Entry tempo" />
                    </Panel>
                    <Button Classes="cell" Command="{Binding TempoUpCommand}" AutomationProperties.Name="Entry tempo up"><c:Icon Glyph="plus" IconSize="14" /></Button>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,4">
                    <TextBlock Classes="label" Text="COUNT-IN" VerticalAlignment="Center" />
                    <ComboBox Classes="cell" ItemsSource="{Binding CountInChoices}" SelectedItem="{Binding CountIn}" MinWidth="140" AutomationProperties.Name="Count-in" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,4">
                    <TextBlock Classes="label" Text="MIX" VerticalAlignment="Center" />
                    <ComboBox Classes="cell" ItemsSource="{Binding MixPresets}" SelectedItem="{Binding MixPreset}" MinWidth="140" AutomationProperties.Name="Mix preset" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,4" IsVisible="{Binding HasTransition}">
                    <TextBlock Classes="label" Text="THEN" VerticalAlignment="Center" />
                    <Button Classes="chip" Command="{Binding EditTransitionCommand}" AutomationProperties.Name="Transition after this song">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <c:Icon Glyph="transition" IconSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TransitionText}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                    <TextBlock Classes="label" Text="NOTES" VerticalAlignment="Center" />
                    <TextBox Classes="cell" Text="{Binding Notes}" Width="260" PlaceholderText="For the band, shown in the setlist" AutomationProperties.Name="Entry notes" />
                  </StackPanel>
                </WrapPanel>
              </StackPanel>
            </Border>
            <DockPanel DataContext="{Binding Entry}" x:DataType="vm:EntryViewModel">
              <!-- Variants (ARR-1…3) -->
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                <TextBox x:Name="VariantNameBox" Text="{Binding VariantName}" PlaceholderText="Variant name" Width="180" />
                <Button Content="New from As written" Command="{Binding NewFromWrittenCommand}" ToolTip.Tip="A variant that starts as the song is written" />
                <Button Content="New from this" Command="{Binding NewFromCurrentCommand}" ToolTip.Tip="A copy of the variant that is playing" />
                <Button Content="New empty" Command="{Binding NewEmptyCommand}" ToolTip.Tip="A variant with nothing in it yet" />
                <Button Content="Rename" Command="{Binding RenameVariantCommand}" ToolTip.Tip="Give the playing variant the name in the box" />
                <Button Content="Delete" Command="{Binding DeleteVariantCommand}" ToolTip.Tip="Delete the playing variant (Ctrl+Z brings it back)" />
                <Button Content="Set as default" Command="{Binding SetDefaultCommand}" ToolTip.Tip="Open this song with the playing variant" />
              </StackPanel>

              <!-- Palette: add a section, a click count-in, a pad or a hold (ARR-20) -->
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
                  <Button Content="+ Click" Command="{Binding AddClickCommand}" ToolTip.Tip="Four bars of click" />
                  <Button Content="+ Pad" Command="{Binding AddPadCommand}" ToolTip.Tip="Eight bars of pad" />
                  <Button Content="+ Hold" Command="{Binding AddHoldCommand}" ToolTip.Tip="Wait here until cued" />
                </StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                  <ItemsControl x:Name="Palette" ItemsSource="{Binding Palette}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PaletteItem">
                        <Button Tag="{Binding SectionId}" Click="OnPaletteClick" Classes="cell" ToolTip.Tip="Add this section to the end of the list, or after the selected entry">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Classes="badge" MinWidth="26" Background="{Binding ColorToken, Converter={x:Static c:TokenBrushConverter.Instance}}">
                              <TextBlock Text="{Binding Badge}" />
                            </Border>
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>

              <!-- Quick order (ARR-60) -->
              <Border DockPanel.Dock="Bottom" Classes="inset" Padding="12,8" Margin="0,8,0,0">
                <StackPanel Spacing="6">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Apply" Classes="primary" Command="{Binding ApplyQuickOrderCommand}" Margin="8,0,0,0" />
                    <TextBlock DockPanel.Dock="Left" Classes="label" Text="QUICK ORDER" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBox x:Name="QuickOrderBox" Text="{Binding QuickOrderText}" PlaceholderText="V1 C V2 C B x2 C+2 End" />
                  </DockPanel>
                  <ItemsControl ItemsSource="{Binding QuickTokens}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:QuickTokenViewModel">
                        <Border Classes="inset" Padding="6,2" Margin="0,0,6,4" ToolTip.Tip="{Binding Message}">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding Text}" Classes="mono" />
                            <TextBlock Text="→" Classes="meta" IsVisible="{Binding IsOk}" />
                            <TextBlock Text="{Binding Label}" IsVisible="{Binding IsOk}" />
                            <TextBlock Text="{Binding Message}" Foreground="{DynamicResource state-warning}" IsVisible="{Binding !IsOk}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="meta" Text="{Binding QuickOrderStatus}" />
                </StackPanel>
              </Border>

              <!-- Summary and warnings (ARR-13, ARR-50) -->
              <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,8,0,0">
                <TextBlock x:Name="EntrySummary" Text="{Binding SummaryLabels}" TextWrapping="Wrap" />
                <TextBlock Classes="readout" Text="{Binding SummaryTotals}" />
                <ItemsControl ItemsSource="{Binding Issues}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <TextBlock Text="{Binding}" Foreground="{DynamicResource state-warning}" TextWrapping="Wrap" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- Options of the selected entry (ARR-21, ARR-22) -->
              <Border DockPanel.Dock="Right" Classes="inset" Padding="12,10" Margin="12,0,0,0" Width="300"
                      IsVisible="{Binding HasSelection}">
                <ScrollViewer>
                  <StackPanel Spacing="8" IsEnabled="{Binding IsVariant}">
                    <TextBlock Classes="label" Text="OPTIONS" />
                    <StackPanel IsVisible="{Binding SelectedIsSection}" Spacing="8">
                      <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" >
                        <TextBlock Grid.Row="0" Text="Repeat" VerticalAlignment="Center" Margin="0,0,0,6" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                          <TextBox Classes="cell" Text="{Binding RepeatCount}" Width="56" AutomationProperties.Name="Repeat count" />
                          <CheckBox Content="until cued" IsChecked="{Binding UntilCued}" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Bars" VerticalAlignment="Center" Margin="0,0,0,6" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                          <TextBox Classes="cell" Text="{Binding FromText}" PlaceholderText="from" Width="64" AutomationProperties.Name="First bar" />
                          <TextBlock Text="to" VerticalAlignment="Center" />
                          <TextBox Classes="cell" Text="{Binding ToText}" PlaceholderText="end" Width="64" AutomationProperties.Name="Last bar" />
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="Key lift" VerticalAlignment="Center" Margin="0,0,0,6" />
                        <TextBox Grid.Row="2" Grid.Column="1" Classes="cell" Text="{Binding Lift}" Width="56" HorizontalAlignment="Left" Margin="0,0,0,6"
                                 ToolTip.Tip="Semitones, −6 to +6, on top of the entry key" AutomationProperties.Name="Key lift" />
                        <TextBlock Grid.Row="3" Text="Mute" VerticalAlignment="Center" Margin="0,0,0,6" />
                        <StackPanel Grid.Row="3" Grid.Column="1" Spacing="4" Margin="0,0,0,6">
                          <ComboBox ItemsSource="{Binding MuteChoices}" SelectedItem="{Binding Mute}" HorizontalAlignment="Stretch" AutomationProperties.Name="Mute" />
                          <CheckBox Content="first pass only" IsChecked="{Binding FirstPassOnly}" />
                        </StackPanel>
                        <TextBlock Grid.Row="4" Text="Fade in (bars)" VerticalAlignment="Center" Margin="0,0,0,6" />
                        <TextBox Grid.Row="4" Grid.Column="1" Classes="cell" Text="{Binding FadeInBars}" Width="56" HorizontalAlignment="Left" Margin="0,0,0,6" AutomationProperties.Name="Fade in" />
                        <TextBlock Grid.Row="5" Text="Fade out (bars)" VerticalAlignment="Center" Margin="0,0,0,6" />
                        <TextBox Grid.Row="5" Grid.Column="1" Classes="cell" Text="{Binding FadeOutBars}" Width="56" HorizontalAlignment="Left" Margin="0,0,0,6" AutomationProperties.Name="Fade out" />
                        <TextBlock Grid.Row="6" Text="Ending" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding EndingChoices}" SelectedItem="{Binding Ending}" HorizontalAlignment="Stretch" AutomationProperties.Name="Ending" />
                      </Grid>
                    </StackPanel>
                    <StackPanel IsVisible="{Binding SelectedIsGenerated}" Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="Bars" VerticalAlignment="Center" />
                      <TextBox Classes="cell" Text="{Binding LengthBars}" Width="56" AutomationProperties.Name="Length in bars" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                      <TextBlock Text="Note" />
                      <TextBox Text="{Binding Note}" MaxLength="80" PlaceholderText="Shown on NOW and NEXT" AutomationProperties.Name="Note" />
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>
              </Border>

              <!-- The entry list (ARR-12), with the as-written note under it rather than over it -->
              <StackPanel>
                <ListBox x:Name="EntryRows" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" Background="Transparent">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:EntryRowViewModel">
                      <Grid ColumnDefinitions="28,Auto,*,Auto" Margin="0,2">
                        <TextBlock Grid.Column="0" Classes="mono" Text="{Binding Index}" VerticalAlignment="Center" Foreground="{DynamicResource text-secondary}" />
                        <Border Grid.Column="1" Classes="badge" IsVisible="{Binding IsSection}" Margin="0,0,8,0"
                                Background="{Binding ColorToken, Converter={x:Static c:TokenBrushConverter.Instance}}">
                          <TextBlock Text="{Binding Badge}" />
                        </Border>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                          <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                          <TextBlock Classes="meta" Text="{Binding Note}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                     IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="{Binding Issue}" Foreground="{DynamicResource state-warning}" VerticalAlignment="Center"
                                   IsVisible="{Binding HasIssue}" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{Binding AsWrittenNote}" Classes="meta" Margin="12,4" TextWrapping="Wrap" IsVisible="{Binding IsAsWritten}" />
              </StackPanel>
            </DockPanel>
            </DockPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="SECTIONS">
            <DockPanel>
            <!-- Automatic section cues (AUTO-20) -->
            <Border DockPanel.Dock="Bottom" Classes="inset" Padding="12,4" Margin="16,4,16,8" IsVisible="{Binding Song, Converter={x:Static ObjectConverters.IsNotNull}}">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock Classes="heading" Text="Automatic section cues" VerticalAlignment="Center" />
                  <TextBlock Classes="meta" Text="Section jumps, vamps and auto-cues all follow the live arrangement." VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <WrapPanel ItemSpacing="24">
                  <CheckBox IsChecked="{Binding SectionNotes}" Content="Send a MIDI note per section type (for lighting looks)" />
                  <CheckBox IsChecked="{Binding SpokenGuide}" Content="Spoken guide (&quot;Chorus&quot; one bar ahead)" />
                </WrapPanel>
              </StackPanel>
            </Border>
            <DockPanel DataContext="{Binding Sections}" x:DataType="vm:SectionsViewModel" Margin="16,12,16,0">
              <!-- Toolbar: Detect, Review, + At playhead, Split (SEC-10, SEC-30, SEC-50, SEC-53) -->
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
                  <Button x:Name="DetectButton" Classes="primary" Content="Detect from guide" Command="{Binding DetectCommand}" ToolTip.Tip="{Binding DetectHint}" />
                  <Button Content="{Binding ReviewLabel}" Command="{Binding ReviewCommand}" ToolTip.Tip="Step through the sections that need review" />
                  <Button Command="{Binding AddAtPlayheadCommand}" ToolTip.Tip="Add a section at the playhead (like M) and name it">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <c:Icon Glyph="plus" IconSize="14" VerticalAlignment="Center" />
                      <TextBlock Text="At playhead" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button x:Name="SplitButton" Content="Split at playhead" ToolTip.Tip="Split the section under the playhead (S)" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0" IsVisible="{Binding IsBusy}">
                  <c:Icon Glyph="rendering" IconSize="14" TextElement.Foreground="{DynamicResource state-pending}" VerticalAlignment="Center" />
                  <TextBlock Classes="meta" Text="{Binding BusyText}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Classes="meta" Text="{Binding DetectHint}" VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding !IsBusy}" />
              </DockPanel>

              <!-- Result box (SEC-16) -->
              <Border DockPanel.Dock="Top" Classes="inset" Padding="12,8" Margin="0,0,0,8" IsVisible="{Binding HasResult}">
                <SelectableTextBlock x:Name="ResultBox" Text="{Binding ResultText}" TextWrapping="Wrap" />
              </Border>

              <!-- Review (SEC-30, SEC-31) -->
              <Border DockPanel.Dock="Top" Classes="inset" Padding="12,8" Margin="0,0,0,8" IsVisible="{Binding IsReviewing}"
                      BorderBrush="{DynamicResource state-warning}" BorderThickness="1">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Left" Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Classes="heading" Text="{Binding ReviewTitle}" />
                    <TextBlock Classes="meta" Text="{Binding ReviewHeard}" />
                  </StackPanel>
                  <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Classes="primary" Content="Accept  ⏎" Command="{Binding AcceptCommand}" Margin="0,2,6,2" ToolTip.Tip="Accept this start (Enter)" />
                    <Button Content="Earlier  ←" Command="{Binding EarlierCommand}" Margin="0,2,6,2" ToolTip.Tip="One bar earlier (←)" />
                    <Button Content="Later  →" Command="{Binding LaterCommand}" Margin="0,2,6,2" ToolTip.Tip="One bar later (→)" />
                    <Button x:Name="ReviewRenameButton" Content="Rename  R" Margin="0,2,6,2" ToolTip.Tip="Rename (R)" />
                    <Button x:Name="ReviewTypeButton" Content="Change type  T" Margin="0,2,6,2" ToolTip.Tip="Change the type (T)" />
                    <Button Content="Delete  Del" Command="{Binding ReviewDeleteCommand}" Margin="0,2,6,2" ToolTip.Tip="Delete this section (Delete)" />
                    <Button Content="Next  N" Command="{Binding NextCommand}" Margin="0,2,6,2" ToolTip.Tip="Skip to the next one (N)" />
                    <Button Content="Play again" Command="{Binding ReplayCommand}" Margin="0,2,6,2" />
                    <Button Classes="ghost" Content="Stop review" Command="{Binding StopReviewCommand}" Margin="0,2,6,2" ToolTip.Tip="Esc" />
                  </WrapPanel>
                </DockPanel>
              </Border>

              <!-- The table (SEC-51), always in time order -->
              <Grid DockPanel.Dock="Top" ColumnDefinitions="28,44,*,150,100,72,64,40,84,40" Margin="8,0,8,4">
                <TextBlock Grid.Column="2" Classes="label" Text="LABEL" />
                <TextBlock Grid.Column="3" Classes="label" Text="TYPE" />
                <TextBlock Grid.Column="4" Classes="label" Text="START (S)" />
                <TextBlock Grid.Column="5" Classes="label" Text="CHART BAR" />
                <TextBlock Grid.Column="6" Classes="label" Text="BARS" />
                <TextBlock Grid.Column="7" Classes="label" Text="CALL" />
              </Grid>
              <TextBlock DockPanel.Dock="Top" Classes="meta" Margin="8" IsVisible="{Binding IsEmpty}" TextWrapping="Wrap"
                         Text="No sections yet. Press Detect from guide, or play the song and press M at each section." />
              <ListBox x:Name="SectionRows" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:SectionRowViewModel">
                    <Grid Classes="row" Classes.flash="{Binding Flash}" ColumnDefinitions="28,44,*,150,100,72,64,40,84,40">
                      <c:Icon Grid.Column="0" Glyph="warning" IconSize="16" IsVisible="{Binding NeedsReview}" VerticalAlignment="Center"
                              TextElement.Foreground="{DynamicResource state-warning}" ToolTip.Tip="Needs review" />
                      <Border Grid.Column="1" Classes="badge" Background="{Binding ColorToken, Converter={x:Static c:TokenBrushConverter.Instance}}">
                        <Panel>
                          <TextBlock Text="{Binding Badge}" IsVisible="{Binding HasBadge}" />
                          <c:Icon Glyph="diamond" IconSize="12" IsVisible="{Binding !HasBadge}" HorizontalAlignment="Center"
                                  TextElement.Foreground="{DynamicResource text-on-section}" />
                        </Panel>
                      </Border>
                      <TextBox Grid.Column="2" Classes="cell" Tag="section-name" Text="{Binding Name}" Margin="0,0,8,0"
                               ToolTip.Tip="{Binding Label}" />
                      <ComboBox Grid.Column="3" Classes="cell" ItemsSource="{Binding Types}" SelectedItem="{Binding Type}" Tag="section-type"
                                HorizontalAlignment="Stretch" Margin="0,0,8,0" />
                      <TextBox Grid.Column="4" Classes="cell mono" Tag="section-start" Text="{Binding StartText}" Margin="0,0,8,0"
                               FontFamily="{DynamicResource FontMono}" ToolTip.Tip="Seconds; snaps to the nearest bar" />
                      <TextBlock Grid.Column="5" Classes="mono" Text="{Binding ChartBarText}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="6" Classes="mono" Text="{Binding LengthText}" VerticalAlignment="Center" />
                      <Button Grid.Column="7" Classes="ghost cell" Command="{Binding PlayCallCommand}" IsEnabled="{Binding HasCall}"
                              ToolTip.Tip="{Binding CallTip}" AutomationProperties.Name="Play the guide call">
                        <c:Icon Glyph="play" IconSize="14" />
                      </Button>
                      <Button Grid.Column="8" Classes="cell" Content="Playhead" Command="{Binding ToPlayheadCommand}"
                              ToolTip.Tip="Start this section at the playhead (nearest bar)" />
                      <Button Grid.Column="9" Classes="ghost cell" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete this section"
                              AutomationProperties.Name="Delete section">
                        <c:Icon Glyph="close" IconSize="14" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
            </DockPanel>
          </TabItem>

          <!-- Cues (AUTO-6) -->
          <TabItem Header="CUES">
            <DockPanel Margin="16,12,16,0">
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                <Button Command="{Binding AddCueCommand}" ToolTip.Tip="Add a cue at the playhead (C)">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:Icon Glyph="plus" IconSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="At playhead" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <TextBlock Classes="meta" Text="C adds a cue at the playhead" VerticalAlignment="Center" />
              </StackPanel>
              <Grid DockPanel.Dock="Top" ColumnDefinitions="140,170,110,110,50,130,80,40,84,40" Margin="8,0,8,4">
                <TextBlock Grid.Column="0" Classes="label" Text="CUE" />
                <TextBlock Grid.Column="1" Classes="label" Text="POSITION" />
                <TextBlock Grid.Column="2" Classes="label" Text="ACTION" />
                <TextBlock Grid.Column="3" Classes="label" Text="VALUE" />
                <TextBlock Grid.Column="4" Classes="label" Text="CH" />
                <TextBlock Grid.Column="5" Classes="label" Text="PASSES" />
                <TextBlock Grid.Column="6" Classes="label" Text="SNAP" />
                <TextBlock Grid.Column="7" Classes="label" Text="ON" />
              </Grid>
              <TextBlock DockPanel.Dock="Top" Classes="meta" Margin="8" IsVisible="{Binding !HasCues}" TextWrapping="Wrap"
                         Text="No cues yet. Play the song and press C where lights or slides should change." />
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Cues}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CueRowViewModel">
                      <StackPanel Margin="8,2">
                        <Grid ColumnDefinitions="140,170,110,110,50,130,80,40,84,40">
                          <DockPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock DockPanel.Dock="Left" Text="◆" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Classes="cell" Text="{Binding Name}" AutomationProperties.Name="Cue name" />
                          </DockPanel>
                          <TextBlock Grid.Column="1" Classes="mono" Text="{Binding PositionText}" VerticalAlignment="Center" />
                          <ComboBox Grid.Column="2" Classes="cell" ItemsSource="{x:Static vm:CueRowViewModel.Kinds}" SelectedItem="{Binding Kind}" Margin="0,0,8,0"
                                    HorizontalAlignment="Stretch" AutomationProperties.Name="Cue action" />
                          <TextBox Grid.Column="3" Classes="cell mono" Text="{Binding Value}" Margin="0,0,8,0" FontFamily="{DynamicResource FontMono}"
                                   ToolTip.Tip="{Binding Summary}" AutomationProperties.Name="Cue value" />
                          <TextBox Grid.Column="4" Classes="cell mono" Text="{Binding Channel}" Margin="0,0,8,0" AutomationProperties.Name="MIDI channel" />
                          <ComboBox Grid.Column="5" Classes="cell" ItemsSource="{x:Static vm:CueRowViewModel.PassChoices}" SelectedItem="{Binding Passes}" Margin="0,0,8,0"
                                    HorizontalAlignment="Stretch" AutomationProperties.Name="Passes" />
                          <ComboBox Grid.Column="6" Classes="cell" ItemsSource="{x:Static vm:CueRowViewModel.SnapChoices}" SelectedItem="{Binding Snap}" Margin="0,0,8,0"
                                    HorizontalAlignment="Stretch" AutomationProperties.Name="Snap" />
                          <CheckBox Grid.Column="7" IsChecked="{Binding Enabled}" AutomationProperties.Name="Enabled" />
                          <Button Grid.Column="8" Classes="cell" Content="Playhead" Command="{Binding PlayheadCommand}" ToolTip.Tip="Move the cue to the playhead" />
                          <Button Grid.Column="9" Classes="ghost cell" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete this cue" AutomationProperties.Name="Delete cue">
                            <c:Icon Glyph="close" IconSize="14" />
                          </Button>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="20,2,0,0" IsVisible="{Binding HasWarning}">
                          <c:Icon Glyph="warning" IconSize="14" TextElement.Foreground="{DynamicResource state-warning}" VerticalAlignment="Center" />
                          <TextBlock Classes="meta" Text="{Binding Warning}" />
                        </StackPanel>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </TabItem>

          <!-- Log (AUTO-50) -->
          <TabItem Header="LOG">
            <DockPanel Margin="16,12,16,0">
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                  <TextBox Text="{Binding LogSearch}" PlaceholderText="Search" Width="200" AutomationProperties.Name="Search the log" />
                  <Button Content="Clear view" Command="{Binding ClearLogCommand}" ToolTip.Tip="Empties this view; the log files keep everything" />
                  <Button Content="Export…" Command="{Binding ExportLogCommand}" ToolTip.Tip="Save the lines shown as .txt or .csv" />
                </StackPanel>
                <ListBox ItemsSource="{Binding LogChipChoices}" SelectedItem="{Binding LogChip}" Background="Transparent"
                         AutomationProperties.Name="Log category">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                </ListBox>
              </DockPanel>
              <TextBlock DockPanel.Dock="Top" Classes="meta" Margin="8" IsVisible="{Binding !ShownLog.Count}" Text="Nothing logged yet." />
              <ListBox ItemsSource="{Binding ShownLog}" Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="log:LogEntry">
                    <SelectableTextBlock Classes="mono" Text="{Binding Line}" FontFamily="{DynamicResource FontMono}" TextWrapping="Wrap" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </TabItem>

          <TabItem Header="MIXER">
            <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="16,8,16,4">
              <TextBlock Classes="label" Text="MIX PRESET" VerticalAlignment="Center" />
              <ComboBox x:Name="MixPresetSelect" ItemsSource="{Binding MixPresetChoices}" SelectedItem="{Binding CurrentMixPreset}" MinWidth="200"
                        AutomationProperties.Name="Mix preset" ToolTip.Tip="The mix this entry plays with; fader moves change it" />
              <Button Content="Save as new…" Command="{Binding SaveMixAsNewCommand}" />
              <Button Content="Rename" Command="{Binding RenameMixCommand}" />
              <Button Content="Delete" Command="{Binding DeleteMixCommand}" />
            </StackPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <StackPanel Orientation="Horizontal">
                <ItemsControl x:Name="Mixer" ItemsSource="{Binding Song.Tracks}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TrackViewModel">
                      <Border Classes="strip" Width="112">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Top" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                          <TextBlock DockPanel.Dock="Top" Classes="meta" Text="{Binding RoleLabel}" TextTrimming="CharacterEllipsis" />
                          <TextBlock DockPanel.Dock="Bottom" Classes="meta" Text="{Binding OutputLabel}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <ToggleButton Classes="ms mute" Content="M" IsChecked="{Binding Mute}" ToolTip.Tip="Mute" />
                            <ToggleButton Classes="ms solo" Content="S" IsChecked="{Binding Solo}" ToolTip.Tip="Solo" />
                            <ToggleButton Classes="ms" Content="#" IsChecked="{Binding Transposes}" ToolTip.Tip="Follows the entry key (click and guide never do)"
                                          AutomationProperties.Name="Follows the key" />
                          </StackPanel>
                          <TextBlock DockPanel.Dock="Bottom" Classes="mono" Text="{Binding GainText}" HorizontalAlignment="Center" />
                          <Grid ColumnDefinitions="*,10" Margin="0,6">
                            <Slider Grid.Column="0" Orientation="Vertical" Minimum="-60" Maximum="6" Value="{Binding GainDb}"
                                    HorizontalAlignment="Center" Tag="fader"
                                    ToolTip.Tip="Double-click for 0.0 dB" />
                            <c:LevelMeter Grid.Column="1" Value="{Binding Meter}" Margin="0,8" />
                          </Grid>
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- MASTER -->
                <ContentControl Content="{Binding Song.Master}">
                  <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:TrackViewModel">
                      <Border Classes="strip" Width="112">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Top" Text="MASTER" FontWeight="Bold" />
                          <TextBlock DockPanel.Dock="Top" Classes="meta" Text="All outputs" />
                          <TextBlock DockPanel.Dock="Bottom" Classes="mono" Text="{Binding GainText}" HorizontalAlignment="Center" Margin="0,0,0,32" />
                          <Grid ColumnDefinitions="*,10" Margin="0,6">
                            <Slider Grid.Column="0" Orientation="Vertical" Minimum="-60" Maximum="6" Value="{Binding GainDb}"
                                    HorizontalAlignment="Center" Tag="fader" ToolTip.Tip="Double-click for 0.0 dB" />
                            <c:LevelMeter Grid.Column="1" Value="{Binding Meter}" Margin="0,8" />
                          </Grid>
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>
              </StackPanel>
            </ScrollViewer>
            </DockPanel>
          </TabItem>

          <TabItem Header="SONG">
            <ScrollViewer>
              <Grid ColumnDefinitions="Auto,320,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="16" >
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="TITLE" VerticalAlignment="Center" Margin="0,0,16,8" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Song.TitleText}" Margin="0,0,0,8" />
                <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="KEY" VerticalAlignment="Center" Margin="0,0,16,8" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Song.KeyText}" PlaceholderText="B♭, F♯m, E" Margin="0,0,0,8" />
                <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="BPM" VerticalAlignment="Center" Margin="0,0,16,8" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Song.BpmText}" Margin="0,0,0,8" />
                <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="METER" VerticalAlignment="Center" Margin="0,0,16,8" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Song.MeterText}" PlaceholderText="4/4" Margin="0,0,0,8" />
                <TextBlock Grid.Row="4" Grid.Column="0" Classes="label" Text="FIRST DOWNBEAT" VerticalAlignment="Center" Margin="0,0,16,8" />
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Song.DownbeatText}" PlaceholderText="seconds, e.g. 0.020" Margin="0,0,0,8" />
                <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Margin="0,4,0,12">
                  <Button Content="Save song details" Command="{Binding ApplySongEditsCommand}" />
                  <Button Content="Detect from click" Command="{Binding DetectDownbeatCommand}" ToolTip.Tip="Find the first downbeat in the click track" />
                  <Button Content="Re-analyse click" Command="{Binding ReanalyseClickCommand}" ToolTip.Tip="BPM, meter and first downbeat from the click track" />
                  <Button Content="Re-transcribe guide" Command="{Binding RetranscribeCommand}" ToolTip.Tip="Listen to the guide track again" />
                </StackPanel>
                <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Spacing="4">
                  <TextBlock Classes="label" Text="SOURCE FOLDER" />
                  <TextBlock Classes="mono" Text="{Binding Song.SourceFolder}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Row="0" Grid.Column="2" Grid.RowSpan="6" Classes="meta" Margin="24,0,0,0" TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Left"
                           Text="BPM, meter and first downbeat set the bar grid for the ruler, the sections and the readouts. They come from the click track after import; values typed here are kept until you press Re-analyse click." />
              </Grid>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </Grid>
    </Grid>

    <!-- Toast (UI-70) -->
    <Border Grid.Row="2" Classes="toast" IsVisible="{Binding HasToast}"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Text="{Binding Toast}" VerticalAlignment="Center" />
        <Button Classes="ghost" Content="Undo" Command="{Binding UndoCommand}" IsVisible="{Binding ToastCanUndo}"
                Padding="8,0" MinHeight="24" Height="24" ToolTip.Tip="Ctrl+Z" />
      </StackPanel>
    </Border>
  
    <!-- Perform replaces the whole window below the title (UI-40); playback never stops when it opens -->
    <local:PerformView x:Name="Perform" Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding IsPerform}" />

    <!-- Assistant (UI-17, AS-2): a drawer over the right edge in Prepare and Perform, below the top bar; Ctrl+J -->
    <Border Grid.Row="0" Grid.RowSpan="3" Width="400" HorizontalAlignment="Right" Classes="panel drawer" BorderBrush="{DynamicResource border}" BorderThickness="1,0,0,0"
            Classes.perform="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsPerform}"
            Background="{DynamicResource bg-surface}" IsVisible="{Binding IsOpen}" DataContext="{Binding $parent[Window].((vm:MainViewModel)DataContext).Assistant}" x:DataType="vm:AssistantViewModel">
      <DockPanel Margin="12">
        <!-- Header: title, Undo, New conversation, settings, close -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <Button DockPanel.Dock="Right" Classes="ghost" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleAssistantCommand}" ToolTip.Tip="Close (Ctrl+J)" AutomationProperties.Name="Close assistant">
            <c:Icon Glyph="close" IconSize="14" />
          </Button>
          <Button DockPanel.Dock="Right" Classes="ghost" Command="{Binding SettingsCommand}" ToolTip.Tip="Settings › Assistant" AutomationProperties.Name="Assistant settings">
            <c:Icon Glyph="settings" IconSize="14" />
          </Button>
          <Button DockPanel.Dock="Right" Classes="ghost" Content="New conversation" Command="{Binding NewConversationCommand}" />
          <Button DockPanel.Dock="Right" Classes="ghost" Command="{Binding UndoCommand}" ToolTip.Tip="Undo the assistant's last change" AutomationProperties.Name="Undo assistant change">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <c:Icon Glyph="undo" IconSize="14" VerticalAlignment="Center" />
              <TextBlock Text="Undo" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <TextBlock Classes="heading" Text="Assistant" VerticalAlignment="Center" />
        </DockPanel>

        <!-- Settings › Assistant (AS-1) -->
        <Border DockPanel.Dock="Top" Classes="inset" Padding="12" Margin="0,0,0,8" IsVisible="{Binding ShowSettings}">
          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="ANTHROPIC API KEY" />
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Save" Command="{Binding SaveKeyCommand}" Margin="6,0,0,0" />
              <TextBox Text="{Binding KeyText}" PasswordChar="•" PlaceholderText="sk-ant-…" AutomationProperties.Name="Anthropic API key" />
            </DockPanel>
            <TextBlock Classes="meta" Text="{Binding KeyStatus}" TextWrapping="Wrap" />
            <TextBlock Classes="label" Text="WORKSPACE ID (OPTIONAL)" Margin="0,6,0,0" />
            <TextBox Text="{Binding WorkspaceId}" AutomationProperties.Name="Workspace ID" />
            <TextBlock Classes="label" Text="MODEL" Margin="0,6,0,0" />
            <AutoCompleteBox Text="{Binding Model}" ItemsSource="{Binding SuggestedModels}" FilterMode="StartsWith" AutomationProperties.Name="Model" />
            <CheckBox IsChecked="{Binding ConfirmInPerform}" Content="Allow changes during Perform, with confirmation" Margin="0,6,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
              <Button Content="Test connection" Command="{Binding TestCommand}" />
              <TextBlock Text="{Binding TestResult}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="220" />
            </StackPanel>
            <TextBlock Classes="meta" Text="{Binding PrivacyNote}" TextWrapping="Wrap" Margin="0,6,0,0" />
          </StackPanel>
        </Border>

        <!-- Composer -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
          <Button DockPanel.Dock="Right" Classes="primary" Content="Send" Command="{Binding SendCommand}" Margin="6,0,0,0" VerticalAlignment="Bottom" />
          <TextBox x:Name="AssistantComposer" Text="{Binding Draft}" TextWrapping="Wrap" MaxHeight="120" AcceptsReturn="False"
                   PlaceholderText="Describe a change to the service, a song or its cues…" AutomationProperties.Name="Message to the assistant">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding SendCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
        </DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsWorking}" Margin="0,6,0,0">
          <c:Icon Glyph="rendering" IconSize="14" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource state-pending}" />
          <TextBlock Classes="meta" Text="Working on it" VerticalAlignment="Center" />
        </StackPanel>

        <!-- UI-80: no key yet -->
        <Border DockPanel.Dock="Top" Classes="inset" Padding="12" IsVisible="{Binding NeedsKey}">
          <StackPanel Spacing="8">
            <TextBlock Text="Add your Anthropic API key to use the assistant" TextWrapping="Wrap" />
            <Button Content="Open settings" Command="{Binding SettingsCommand}" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>

        <!-- Messages -->
        <ScrollViewer x:Name="AssistantScroll">
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AssistantRow">
                <Panel Margin="0,4">
                  <Border IsVisible="{Binding IsUser}" Classes="inset" Padding="10,6" HorizontalAlignment="Right" MaxWidth="320" Background="{DynamicResource accent-subtle}">
                    <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                  </Border>
                  <SelectableTextBlock IsVisible="{Binding IsAssistant}" Text="{Binding Text}" TextWrapping="Wrap" />
                  <TextBlock IsVisible="{Binding IsNote}" Classes="meta" Classes.error="{Binding IsError}" Text="{Binding Text}" TextWrapping="Wrap" />
                  <Border IsVisible="{Binding IsCard}" Classes="inset" Padding="10" BorderBrush="{DynamicResource state-pending}" BorderThickness="1">
                    <StackPanel Spacing="8">
                      <TextBlock Classes="label" Text="CONFIRM CHANGE" />
                      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsPending}">
                        <Button Classes="primary" Content="Apply" Command="{Binding ApplyCommand}" />
                        <Button Content="Discard" Command="{Binding DiscardCommand}" />
                      </StackPanel>
                      <TextBlock Classes="meta" Text="{Binding Status}" IsVisible="{Binding !IsPending}" />
                    </StackPanel>
                  </Border>
                </Panel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
</Grid>
</Window>
