<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>RECompose</AssemblyName>
    <RootNamespace>RECompose.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/RECompose.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The XAML compiler logs through MSBuild, which TreatWarningsAsErrors does not reach: obsolete XAML members fail the build too. -->
    <MSBuildWarningsAsErrors>$(MSBuildWarningsAsErrors);AVLN5001</MSBuildWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fonts come from design/fonts (the design system's bundled copies), not a second copy. -->
    <AvaloniaResource Include="$(RepoRoot)design/fonts/*.ttf" Link="Assets/Fonts/%(Filename)%(Extension)" />
    <AvaloniaResource Include="Assets/RECompose.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../RECompose.Core/RECompose.Core.csproj" />
    <ProjectReference Include="../RECompose.Engine/RECompose.Engine.csproj" />
    <ProjectReference Include="../RECompose.Presentation/RECompose.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RECompose.App.Tests" />
  </ItemGroup>
</Project>
