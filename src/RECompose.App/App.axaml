<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RECompose.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <!-- Bundled fonts (PLAT-20); REC Accidentals draws ♭ ♮ ♯ in every style. Colours,
         sizes and type sizes are added from design/tokens.json in App.Initialize. -->
    <FontFamily x:Key="FontSans">avares://RECompose/Assets/Fonts#Hanken Grotesk, avares://RECompose/Assets/Fonts#REC Accidentals</FontFamily>
    <FontFamily x:Key="FontMono">avares://RECompose/Assets/Fonts#Martian Mono, avares://RECompose/Assets/Fonts#REC Accidentals</FontFamily>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://RECompose/Theme/Styles.axaml" />
    <!-- Every window, the dialogs made in code included, shows the app icon (Windows title bars and taskbar). -->
    <Style Selector="Window">
      <Setter Property="Icon" Value="/Assets/RECompose.ico" />
    </Style>
  </Application.Styles>
</Application>
