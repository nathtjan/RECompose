<!-- Settings › Playback and › Controls (SET-20, SET-28, LIVE-50…55): jump timing, the bindings with MIDI Learn. -->
<d:DialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:d="using:RECompose.App.Dialogs"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RECompose.Presentation.ViewModels"
        x:Class="RECompose.App.Dialogs.ControlsWindow"
        x:DataType="vm:ControlsViewModel"
        Title="Controls and playback"
        Width="640" Height="780" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button Content="Restore defaults" Command="{Binding RestoreDefaultsCommand}" />
      <Button x:Name="CloseButton" Classes="primary" Content="Done" IsDefault="True" IsCancel="True" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Top" Spacing="10">
      <TextBlock Classes="title" Text="Playback" />
      <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
        <TextBlock Grid.Row="0" Classes="label" Text="JUMP TAKES EFFECT" VerticalAlignment="Center" />
        <ComboBox x:Name="TimingSelect" Grid.Row="0" Grid.Column="1" ItemsSource="{Binding TimingChoices}" SelectedItem="{Binding SelectedTiming}" HorizontalAlignment="Stretch" />
        <TextBlock Grid.Row="1" Classes="label" Text="AFTER A JUMP" VerticalAlignment="Center" />
        <CheckBox x:Name="ContinueBox" Grid.Row="1" Grid.Column="1" IsChecked="{Binding ContinueAsWritten}"
                  Content="Carry on as written instead of returning to the arrangement" />
        <TextBlock Grid.Row="2" Classes="label" Text="GUIDE CALLS" VerticalAlignment="Center" />
        <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding ReplaceGuideCalls}"
                  Content="Replace guide calls that announce the wrong section"
                  ToolTip.Tip="After a change, the guide's call for the section as written is silenced and the right one plays" />
      </Grid>
      <TextBlock Classes="title" Text="MIDI out" Margin="0,12,0,0" />
      <Grid ColumnDefinitions="180,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="8">
        <TextBlock Grid.Row="0" Classes="label" Text="PORT" VerticalAlignment="Center" />
        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding MidiPorts}" SelectedItem="{Binding MidiPort}" HorizontalAlignment="Stretch"
                  AutomationProperties.Name="MIDI out port" ToolTip.Tip="Lighting software listens here; on Windows use a loopMIDI port or a MIDI interface" />
        <Button Grid.Row="0" Grid.Column="2" Content="Send test note" Command="{Binding TestNoteCommand}" />
        <TextBlock Grid.Row="1" Classes="label" Text="CHANNEL · MIDDLE C" VerticalAlignment="Center" />
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <ComboBox ItemsSource="{Binding Channels}" SelectedItem="{Binding MidiChannel}" MinWidth="80" AutomationProperties.Name="MIDI channel" />
          <ComboBox ItemsSource="{Binding MiddleCChoices}" SelectedItem="{Binding MiddleC}" MinWidth="80" AutomationProperties.Name="Middle C is"
                    ToolTip.Tip="What MIDI note 60 is called" />
        </StackPanel>
      </Grid>
      <TextBlock Classes="title" Text="Controls" Margin="0,12,0,0" />
      <TextBlock Classes="meta" TextWrapping="Wrap"
                 Text="Press Learn, then a key, a note, a controller or a foot pedal. Two presses within 250 ms count once. A pedal acts when it is pressed." />
      <TextBlock Classes="mono" Text="{Binding LastInput}" Foreground="{DynamicResource state-playing}" />
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
      <ItemsControl x:Name="ControlRows" ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ControlRow">
            <Grid ColumnDefinitions="150,*,Auto,Auto" Margin="0,3" ColumnSpacing="8">
              <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Inputs}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="2" Content="{Binding LearnLabel}" Command="{Binding LearnCommand}" MinWidth="150" AutomationProperties.Name="Learn" />
              <Button Grid.Column="3" Content="Clear" Command="{Binding ClearCommand}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</d:DialogWindow>
