<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pure domain logic: data model, plan building, readouts, import rules.
       No UI, no audio, no I/O beyond what is passed in, so everything here is unit-testable. -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
